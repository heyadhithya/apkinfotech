# Optional: set only in secure hosting environment settings, then redeploy.
SITE_URL=https://apkinfotech.vercel.app
# Use off for a staging build outside Vercel previews.
# SEARCH_INDEXING=off
# Verified company-owned HTTPS lead service; blank uses explicit WhatsApp drafts.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=

# Student/LMS portal: persistent single-server storage only, NOT Vercel.
# Development defaults to .data/portal.sqlite and http://localhost:3000.
# Production requires BOTH values; use an absolute database path and HTTPS origin.
# PORTAL_DB_PATH=/absolute/path/to/private/portal.sqlite
# PORTAL_ORIGIN=https://portal.example.com

# Explicit, isolated synthetic simulator. No real login or server data access.
# PORTAL_DEMO_MODE=true
